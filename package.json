{
  "name": "neon-relic-slot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modular, deterministic slot game engine + PixiJS renderer + React HUD.",
  "author": "Oleg Bobokhidze",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @slot/web dev",
    "build": "pnpm --filter @slot/web build",
    "preview": "pnpm --filter @slot/web preview",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "log:decision": "node scripts/log-decision.mjs",
    "report:new": "node scripts/new-report.mjs",
    "e2e": "node e2e/smoke.mjs && node e2e/layout.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "puppeteer-core": "23.11.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
